{
  "name": "@clancode/cli",
  "version": "0.1.0-beta.1",
  "description": "Local-first TrueForge-supervised AI coding harness",
  "type": "module",
  "bin": {
    "clancode": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run --watch src/main.tsx",
    "start": "bun run src/cli.ts",
    "login": "bun run src/cli.ts login",
    "pair": "bun run src/cli.ts pair",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src",
    "build": "bun build src/cli.ts --outfile dist/cli.js --target bun --banner \"#!/usr/bin/env bun\" --external @truefoundry/trueforge --external @truefoundry/trueforge-sdk --external @opentui/core --external @opentui/react --external react && bun run scripts/normalize-dist.ts",
    "prepack": "bun run build",
    "pack:local": "bun run scripts/pack-local.ts",
    "publish:check": "bun run scripts/pack-local.ts --check-only",
    "trueforge:smoke": "bun run scripts/trueforge-smoke.ts",
    "supervisor:smoke": "bun run scripts/supervisor-smoke.ts",
    "turn:smoke": "bun run scripts/turn-smoke.ts",
    "plan:mcp-smoke": "bun run scripts/plan-mcp-smoke.ts",
    "approval:smoke": "bun run scripts/approval-smoke.ts",
    "resume:smoke": "bun run scripts/resume-smoke.ts"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ANAMASGARD/ClanCode.git",
    "directory": "clan-cli/packages/cli"
  },
  "homepage": "https://github.com/ANAMASGARD/ClanCode",
  "bugs": {
    "url": "https://github.com/ANAMASGARD/ClanCode/issues"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "socket.io": "^4.8.3",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.5.6",
    "@opentui/react": "^0.5.6",
    "@truefoundry/trueforge": "0.1.4",
    "@truefoundry/trueforge-sdk": "0.1.3",
    "react": "^19.2.6",
    "socket.io-client": "^4.8.3"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}

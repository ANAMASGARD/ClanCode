# Clerk — user authentication (the only app auth layer)
# https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon PostgreSQL — database only (not auth). Next.js control plane persistence.
# Pull from Neon CLI (postgres service only — no Neon Auth vars):
#   bun run neon:login
#   bun run neon:setup
# Or paste the pooled connection string from https://console.neon.tech manually:
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Device pairing — AES-256-GCM key for one-time token delivery (32 bytes, base64url).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAIRING_DELIVERY_KEY=

# Control plane URLs (development defaults shown)
CLANCODE_WEB_URL=http://localhost:3000
CLANCODE_REALTIME_URL=http://localhost:3001
CLANCODE_REALTIME_PORT=3001
CLANCODE_REALTIME_INTERNAL_URL=http://127.0.0.1:3001
# Shared secret for Next.js → gateway /internal/command (any long random string)
CLANCODE_REALTIME_RELAY_SECRET=
# How long the gateway waits for command.ack (TrueForge cold start is ~30s)
CLANCODE_COMMAND_ACK_TIMEOUT_MS=45000

# Optional — Castle push-to-talk transcription (server-only; mic hidden when unset)
OPENAI_API_KEY=
